<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-versioned TFM so Core can call Windows.Devices.Bluetooth directly. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>KVMate.Core</RootNamespace>
    <AssemblyName>KVMate.Core</AssemblyName>
    <Description>KVM switch detection and Bluetooth speaker handoff.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
