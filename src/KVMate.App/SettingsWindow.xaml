<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KVMate.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KVMate settings">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

            <TextBlock
                Text="KVMate"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock TextWrapping="Wrap">
                Pick the USB device that moves with the KVM switch (normally the keyboard) and the
                Bluetooth speaker to bring along. While the device is plugged into this PC, the
                speaker is connected here; when it leaves, the speaker is let go. Run KVMate on both
                PCs.
            </TextBlock>

            <ComboBox
                x:Name="DevicePicker"
                Header="USB device that marks this PC as active"
                PlaceholderText="Choose a USB device"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Label" />

            <ComboBox
                x:Name="SpeakerPicker"
                Header="Bluetooth speaker"
                PlaceholderText="Choose a paired speaker"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Label" />

            <Button
                x:Name="RefreshButton"
                Content="Refresh lists"
                Click="OnRefreshClick" />

            <CheckBox
                x:Name="StartWithWindowsBox"
                Content="Start with Windows" />

            <InfoBar
                x:Name="Problem"
                Severity="Error"
                IsClosable="True" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick" />
                <Button
                    Content="Cancel"
                    Click="OnCancelClick" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
